# ═══════════════════════════════════════════════════════════════
# CRM BYTE — Environment Variables (EXAMPLE)
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=bytecrm
POSTGRES_USER=bytecrm_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ─── Redis ──────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ─── JWT Secrets (use: openssl rand -hex 32) ────────────────────
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_64_HEX_CHARS

# ─── Security Keys (use: openssl rand -hex 32 for 64, -hex 16 for 32) ─
AUDIT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
VAULT_MASTER_SALT=CHANGE_ME_32_HEX_CHARS
CSRF_SECRET=CHANGE_ME_32_HEX_CHARS

# ─── Biometric Service ─────────────────────────────────────────
BIOMETRIC_API_KEY=CHANGE_ME_STRONG_API_KEY
EMBEDDING_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ─── Evolution API (WhatsApp — optional) ────────────────────────
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# ─── CORS ───────────────────────────────────────────────────────
CORS_ORIGIN=https://app.bytecrm.online
