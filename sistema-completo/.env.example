# ─────────────────────────────────────────────────────────────
# CRM BYTE — Environment Variables
# Copy to .env and fill in all values before running docker-compose
# ─────────────────────────────────────────────────────────────

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=bytecrm
POSTGRES_USER=bytecrm_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ─── JWT Secrets (generate with: openssl rand -hex 64) ─────────
JWT_SECRET=CHANGE_ME_JWT_SECRET_64_HEX_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_64_HEX_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CSRF ──────────────────────────────────────────────────────
CSRF_SECRET=CHANGE_ME_CSRF_SECRET_32_HEX_CHARS

# ─── Audit Log Encryption (AES-256 key, 32 bytes hex) ─────────
AUDIT_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FOR_AES256

# ─── Vault Master Salt (for PBKDF2 server-side validation) ────
VAULT_MASTER_SALT=CHANGE_ME_32_HEX_CHARS

# ─── Biometric Service ────────────────────────────────────────
BIOMETRIC_API_KEY=CHANGE_ME_BIOMETRIC_INTERNAL_API_KEY
EMBEDDING_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FOR_EMBEDDINGS
BIO_WORKERS=2

# ─── Evolution API (WhatsApp) ─────────────────────────────────
EVOLUTION_API_URL=https://your-evolution-instance.com
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=https://app.bytecrm.online

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_GENERAL=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH=5
RATE_LIMIT_AUTH_WINDOW_MS=60000

# ─── Brute Force Detection ────────────────────────────────────
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_MINUTES=15
BRUTE_FORCE_LOCKOUT_MINUTES=30
